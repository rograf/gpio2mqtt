<div class="container dashboard-shell p-3">
    <div class="row">
        <!-- Left: GPIO Grid -->
        <div class="col-lg-8">
            <div id="gpioGrid"></div>
            <!-- Legend -->
            <div class="d-flex justify-content-center mt-4">
                <div class="card mb-3 margin-0" style="width: fit-content;">
                    <div class="card-body py-2 d-flex flex-wrap gap-3">
                        <span class="d-flex align-items-center gap-2"><span class="legend-swatch"></span><small>{{t.dashboard.legend.unused}}</small></span>
                        <span class="d-flex align-items-center gap-2"><span class="legend-swatch monitor"></span><small>{{t.dashboard.legend.monitor}}</small></span>
                        <span class="d-flex align-items-center gap-2"><span class="legend-swatch control"></span><small>{{t.dashboard.legend.control}}</small></span>
                        <span class="d-flex align-items-center gap-2"><span class="legend-swatch uart"></span><small>{{t.dashboard.legend.uart}}</small></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Config Panel -->
        <div class="col-lg-4">
            <div id="configPlaceholder" class="card">
                <div class="card-body text-center text-muted py-5">
                    {{t.dashboard.clickToEdit}}
                </div>
            </div>
            <div id="configPanel" style="display:none;">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0 fw-bold">GPIO<span id="panelGpioNum"></span></h4>
                    <button class="btn-close" onclick="closePanel()"></button>
                </div>

                <!-- Config card -->
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <div class="mb-2">
                            <label class="form-label mb-1">{{t.dashboard.config.name}}</label>
                            <input type="text" class="form-control form-control-sm" id="gpioName" placeholder="{{t.dashboard.config.namePlaceholder}}">
                        </div>
                        <div class="mb-2">
                            <label class="form-label mb-1 d-block">{{t.dashboard.config.type}}</label>
                            <div id="typeGroup">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="gpioType" id="typeMonitor" value="monitor">
                                    <label class="form-check-label" for="typeMonitor">{{t.dashboard.config.typeMonitor}}</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="gpioType" id="typeControl" value="control">
                                    <label class="form-check-label" for="typeControl">{{t.dashboard.config.typeControl}}</label>
                                </div>
                            </div>
                        </div>
                        <div id="saveSection" class="text-end" style="display:none;">
                            <button style="min-width: 10rem;" class="btn btn-primary btn-sm" onclick="saveConfig()">{{t.dashboard.config.save}}</button>
                        </div>
                    </div>
                </div>

                <!-- Control card -->
                <div id="controlSection" class="card mb-2" style="display:none;">
                    <div class="card-body py-2">
                        <div class="mb-2">
                            <label class="form-label mb-1">{{t.dashboard.control.duration}}: <strong id="durationLabel">0s</strong></label>
                            <input type="range" class="form-range" id="durationSlider" min="0" max="60000" step="500" value="0">
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control" id="durationCustom" min="0" value="0">
                                <span class="input-group-text">ms</span>
                            </div>
                        </div>
                        <div class="mb-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="controlAction" id="actionOn" value="true" checked>
                                <label class="form-check-label" for="actionOn">{{t.dashboard.control.actionOn}}</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="controlAction" id="actionOff" value="false">
                                <label class="form-check-label" for="actionOff">{{t.dashboard.control.actionOff}}</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="controlAction" id="actionToggle" value="null">
                                <label class="form-check-label" for="actionToggle">{{t.dashboard.control.actionToggle}}</label>
                            </div>
                        </div>
                        <div class="text-end">
                            <button style="min-width: 10rem;" class="btn btn-primary btn-sm" onclick="sendCommand()">{{t.dashboard.control.send}}</button>
                        </div>
                    </div>
                </div>

                <!-- History card -->
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <h6 class="mb-2">{{t.dashboard.history.title}}</h6>
                        <div id="historyList">
                            <small class="text-muted">{{t.dashboard.history.loading}}</small>
                        </div>
                    </div>
                </div>

                <!-- Delete -->
                <div id="deleteSection" class="text-end" style="display:none;">
                    <button class="btn btn-outline-danger btn-sm" onclick="deleteConfig()">{{t.dashboard.config.delete}}</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentGpio = null;
    let currentUart = false;
    let gpioData = [];

    const t = {{{json t.dashboard}}};
    const uartConfigured = {{#if uartConfigured}}true{{else}}false{{/if}};
    const uartName = {{{json uartName}}};

    const pinMapping = {
        1: { name: '3V3', type: 'power', clickable: false, color: '#d32f2f' },
        2: { name: '5V', type: 'power', clickable: false, color: '#d32f2f' },
        3: { gpio: 2, name: 'GPIO2', alt: 'I2C SDA', type: 'gpio', clickable: true },
        4: { name: '5V', type: 'power', clickable: false, color: '#d32f2f' },
        5: { gpio: 3, name: 'GPIO3', alt: 'I2C SCL', type: 'gpio', clickable: true },
        6: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        7: { gpio: 4, name: 'GPIO4', type: 'gpio', clickable: true },
        8: { gpio: 14, name: 'GPIO14', alt: 'UART TX', type: 'gpio', clickable: true },
        9: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        10: { gpio: 15, name: 'GPIO15', alt: 'UART RX', type: 'gpio', clickable: true },
        11: { gpio: 17, name: 'GPIO17', type: 'gpio', clickable: true },
        12: { gpio: 18, name: 'GPIO18', alt: 'PCM CLK', type: 'gpio', clickable: true },
        13: { gpio: 27, name: 'GPIO27', type: 'gpio', clickable: true },
        14: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        15: { gpio: 22, name: 'GPIO22', type: 'gpio', clickable: true },
        16: { gpio: 23, name: 'GPIO23', type: 'gpio', clickable: true },
        17: { name: '3V3', type: 'power', clickable: false, color: '#d32f2f' },
        18: { gpio: 24, name: 'GPIO24', type: 'gpio', clickable: true },
        19: { gpio: 10, name: 'GPIO10', alt: 'SPI MOSI', type: 'gpio', clickable: true },
        20: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        21: { gpio: 9, name: 'GPIO9', alt: 'SPI MISO', type: 'gpio', clickable: true },
        22: { gpio: 25, name: 'GPIO25', type: 'gpio', clickable: true },
        23: { gpio: 11, name: 'GPIO11', alt: 'SPI SCLK', type: 'gpio', clickable: true },
        24: { gpio: 8, name: 'GPIO8', alt: 'SPI CE0', type: 'gpio', clickable: true },
        25: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        26: { gpio: 7, name: 'GPIO7', alt: 'SPI CE1', type: 'gpio', clickable: true },
        27: { gpio: 0, name: 'GPIO0', alt: 'I2C EEPROM', type: 'gpio', clickable: true },
        28: { gpio: 1, name: 'GPIO1', alt: 'I2C EEPROM', type: 'gpio', clickable: true },
        29: { gpio: 5, name: 'GPIO5', type: 'gpio', clickable: true },
        30: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        31: { gpio: 6, name: 'GPIO6', type: 'gpio', clickable: true },
        32: { gpio: 12, name: 'GPIO12', alt: 'PWM0', type: 'gpio', clickable: true },
        33: { gpio: 13, name: 'GPIO13', alt: 'PWM1', type: 'gpio', clickable: true },
        34: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        35: { gpio: 19, name: 'GPIO19', alt: 'PCM FS', type: 'gpio', clickable: true },
        36: { gpio: 16, name: 'GPIO16', type: 'gpio', clickable: true },
        37: { gpio: 26, name: 'GPIO26', type: 'gpio', clickable: true },
        38: { gpio: 20, name: 'GPIO20', alt: 'PCM DIN', type: 'gpio', clickable: true },
        39: { name: 'GND', type: 'ground', clickable: false, color: '#000' },
        40: { gpio: 21, name: 'GPIO21', alt: 'PCM DOUT', type: 'gpio', clickable: true }
    };

    let eventSource = null;
    let uartEventSource = null;

    if (uartConfigured) {
        // Replace GPIO14/GPIO15 pins with a single logical UART target (shown on both pins)
        pinMapping[8] = { uart: true, name: 'UART', alt: 'uart.js', type: 'uart', clickable: true };
        pinMapping[10] = { uart: true, name: 'UART', alt: 'uart.js', type: 'uart', clickable: true };
    }

    async function loadGpioData() {
        try {
            const response = await fetch('/api/gpio');
            gpioData = await response.json();
            renderGpioGrid();
        } catch (error) {
            console.error('Error loading GPIO data:', error);
        }
    }

    function setupSSE() {
        eventSource = new EventSource('/api/gpio/stream');

        eventSource.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'init') {
                    data.data.forEach(item => updateGpioState(item.gpio, item.type, item.state));
                } else {
                    updateGpioState(data.gpio, data.type, data.state, data.history);
                }
            } catch (error) {
                console.error('Error parsing SSE data:', error);
            }
        };

        eventSource.onerror = () => {
            eventSource.close();
            setTimeout(setupSSE, 5000);
        };
    }

    function updateGpioState(gpio, type, state, historyEntry) {
        const gpioConfig = gpioData.find(g => g.gpio === gpio);
        if (gpioConfig) {
            gpioConfig.state = state;
            gpioConfig.type = type;
            renderGpioGrid();
        }
        // Append history entry in real-time if this GPIO panel is open
        if (historyEntry && gpio === currentGpio) {
            const list = document.getElementById('historyList');
            const placeholder = list.querySelector(':scope > small');
            if (placeholder) placeholder.remove();
            const div = document.createElement('div');
            div.className = 'border-bottom py-1 d-flex justify-content-between';
            div.innerHTML = `<small>${historyEntry.payload}</small>
                <small class="text-muted text-nowrap ms-2">${historyEntry.date}</small>`;
            list.prepend(div);
        }
    }

    function getPinStyle(pinInfo) {
        if (pinInfo.uart) {
            return { bg: '#d1d5db', border: '#d1d5db', color: '#111827' };
        }
        if (pinInfo.gpio !== undefined) {
            const gc = gpioData.find(g => g.gpio === pinInfo.gpio);
            if (gc && gc.type === 'monitor') {
                return gc.state === true
                    ? { bg: '#ff6b11', border: '#ff6b11', color: '#fff' }
                    : { bg: '#fff', border: '#ff6b11', color: '#111827' };
            }
            if (gc && gc.type === 'control') {
                return gc.state === 'on'
                    ? { bg: '#4f7df3', border: '#4f7df3', color: '#fff' }
                    : { bg: '#fff', border: '#4f7df3', color: '#111827' };
            }
        }
        if (pinInfo.type === 'power') {
            return { bg: '#fee2e2', border: '#fca5a5', color: '#991b1b' };
        }
        if (pinInfo.type === 'ground') {
            return { bg: '#111827', border: '#111827', color: '#fff' };
        }
        if (pinInfo.color) return { bg: '#111827', border: '#111827', color: '#fff' };
        return { bg: '#fff', border: '#d1d5db', color: '#111827' };
    }

    function getConfigName(pinInfo, pinNum) {
        if (pinInfo.uart && pinNum === 8) {
            return uartName || 'UART';
        }
        if (pinInfo.uart && pinNum === 10) {
            return null;
        }
        if (pinInfo.gpio === undefined) return null;
        const gc = gpioData.find(g => g.gpio === pinInfo.gpio);
        return (gc && gc.name && gc.name !== pinInfo.name) ? gc.name : null;
    }

    function buildPin(pinInfo, pinNum, side) {
        const pin = document.createElement('div');
        pin.className = 'gpio-pin' + (pinInfo.clickable ? '' : ' no-click');
        if (pinInfo.clickable && ((pinInfo.uart && currentUart) || (!pinInfo.uart && pinInfo.gpio === currentGpio))) pin.classList.add('selected');
        const s = getPinStyle(pinInfo);
        pin.style.background = s.bg;
        pin.style.borderColor = s.border;
        pin.style.color = s.color;

        const badge = `<span class="pin-num">${pinNum}</span>`;
        const name = `<span class="pin-name">${pinInfo.name}</span>`;
        const alt = pinInfo.alt ? `<span class="pin-alt">${pinInfo.alt}</span>` : `<span class="pin-alt" style="visibility:hidden;"></span>`;

        if (side === 'left') {
            pin.style.flexDirection = 'row';
            pin.innerHTML = badge + name + alt;
        } else {
            pin.style.flexDirection = 'row-reverse';
            pin.innerHTML = badge + name + alt;
        }

        if (pinInfo.clickable) {
            pin.onclick = () => {
                if (pinInfo.uart) {
                    openUartPanel();
                    return;
                }
                const gc = gpioData.find(g => g.gpio === pinInfo.gpio);
                openPanel(pinInfo.gpio, gc?.name || pinInfo.name, gc?.type);
            };
        }
        return pin;
    }

    function renderGpioGrid() {
        const grid = document.getElementById('gpioGrid');
        grid.innerHTML = '';

        for (let i = 1; i <= 40; i += 2) {
            const leftInfo = pinMapping[i];
            const rightInfo = pinMapping[i + 1];

            const row = document.createElement('div');
            row.className = 'pin-row';

            const leftName = getConfigName(leftInfo, i) || '';
            const rightName = getConfigName(rightInfo, i + 1) || '';

            const descL = document.createElement('span');
            descL.className = 'pin-desc left';
            descL.textContent = leftName;
            row.appendChild(descL);

            const colL = document.createElement('div');
            colL.className = 'pin-col';
            colL.appendChild(buildPin(leftInfo, i, 'left'));
            const labelL = document.createElement('span');
            labelL.className = 'pin-label';
            labelL.textContent = leftName;
            colL.appendChild(labelL);
            row.appendChild(colL);

            const colR = document.createElement('div');
            colR.className = 'pin-col';
            colR.appendChild(buildPin(rightInfo, i + 1, 'right'));
            const labelR = document.createElement('span');
            labelR.className = 'pin-label';
            labelR.textContent = rightName;
            colR.appendChild(labelR);
            row.appendChild(colR);

            const descR = document.createElement('span');
            descR.className = 'pin-desc right';
            descR.textContent = rightName;
            row.appendChild(descR);

            grid.appendChild(row);
        }
    }

    function renderHistory(entries) {
        const list = document.getElementById('historyList');
        if (!entries || entries.length === 0) {
            list.innerHTML = `<small class="text-muted">${t.history.empty}</small>`;
            return;
        }
        list.innerHTML = entries.map(e =>
            `<div class="border-bottom py-1 d-flex justify-content-between">
                <small>${e.payload}</small>
                <small class="text-muted text-nowrap ms-2">${e.date}</small>
            </div>`
        ).join('');
    }

    function scrollToPanel() {
        const panel = document.getElementById('configPanel');
        const rect = panel.getBoundingClientRect();
        if (rect.top > window.innerHeight || rect.bottom < 0) {
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    async function openPanel(gpioNum, name, type) {
        currentUart = false;
        currentGpio = gpioNum;
        const isConfigured = !!type;

        document.getElementById('panelGpioNum').textContent = gpioNum;
        document.getElementById('gpioName').value = name || '';
        document.getElementById('deleteSection').style.display = isConfigured ? '' : 'none';
        document.getElementById('saveSection').style.display = '';

        // Type radios
        document.getElementById('typeMonitor').checked = type === 'monitor';
        document.getElementById('typeControl').checked = type === 'control';
        document.querySelectorAll('#typeGroup input').forEach(r => r.disabled = isConfigured);

        // Control section
        document.getElementById('controlSection').style.display = type === 'control' ? 'block' : 'none';
        if (type === 'control') {
            document.getElementById('durationSlider').value = 0;
            document.getElementById('durationCustom').value = 0;
            document.getElementById('durationLabel').textContent = '0s';
            document.getElementById('actionOn').checked = true;
        }

        document.getElementById('configPlaceholder').style.display = 'none';
        document.getElementById('configPanel').style.display = 'block';
        renderGpioGrid();

        // Load history
        document.getElementById('historyList').innerHTML = `<small class="text-muted">${t.history.loading}</small>`;
        try {
            const res = await fetch(`/api/gpio/${gpioNum}/history`);
            const history = await res.json();
            renderHistory(history);
        } catch (err) {
            document.getElementById('historyList').innerHTML = `<small class="text-danger">${t.history.loadError}</small>`;
        }
        scrollToPanel();
    }

    async function openUartPanel() {
        currentGpio = null;
        currentUart = true;

        document.getElementById('panelGpioNum').textContent = '';
        document.getElementById('gpioName').value = uartName || 'UART';

        // Hide GPIO-only sections
        document.getElementById('deleteSection').style.display = 'none';
        document.getElementById('saveSection').style.display = 'none';
        document.getElementById('controlSection').style.display = 'none';
        document.querySelectorAll('#typeGroup input').forEach(r => {
            r.checked = false;
            r.disabled = true;
        });

        document.getElementById('configPlaceholder').style.display = 'none';
        document.getElementById('configPanel').style.display = 'block';
        renderGpioGrid();

        document.getElementById('historyList').innerHTML = `<small class="text-muted">${t.history.loading}</small>`;
        try {
            const res = await fetch('/api/uart/history');
            const history = await res.json();
            renderHistory(history);
        } catch (err) {
            document.getElementById('historyList').innerHTML = `<small class="text-danger">${t.history.loadError}</small>`;
        }
        scrollToPanel();
    }

    function closePanel() {
        currentGpio = null;
        currentUart = false;
        document.getElementById('configPanel').style.display = 'none';
        document.getElementById('configPlaceholder').style.display = 'block';

        // Re-enable type radios for GPIO usage
        document.querySelectorAll('#typeGroup input').forEach(r => r.disabled = false);
        renderGpioGrid();
    }

    async function saveConfig() {
        const name = document.getElementById('gpioName').value;
        const typeEl = document.querySelector('input[name="gpioType"]:checked');

        if (!typeEl) {
            alert(t.config.typeRequired);
            return;
        }

        try {
            const response = await fetch('/api/gpio/configure', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ gpio: currentGpio, name, type: typeEl.value })
            });
            const result = await response.json();
            if (result.success) {
                await loadGpioData();
                const gc = gpioData.find(g => g.gpio === currentGpio);
                await openPanel(currentGpio, gc?.name, gc?.type);
            }
        } catch (error) {
            console.error('Save error:', error);
            alert(t.config.saveError);
        }
    }

    async function deleteConfig() {
        if (!confirm(t.config.confirmDelete)) return;

        try {
            const response = await fetch('/api/gpio/configure', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ gpio: currentGpio, name: '', type: null })
            });
            const result = await response.json();
            if (result.success) {
                closePanel();
                await loadGpioData();
            }
        } catch (error) {
            alert(t.config.deleteError);
        }
    }

    async function sendCommand() {
        const actionEl = document.querySelector('input[name="controlAction"]:checked');
        let power;
        if (actionEl.value === 'true') power = true;
        else if (actionEl.value === 'false') power = false;
        else power = null;

        const duration = parseInt(document.getElementById('durationCustom').value) || 0;

        try {
            await fetch('/api/gpio/control', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ gpio: currentGpio, power, duration })
            });
        } catch (error) {
            console.error('Error sending command:', error);
        }
    }

    // Duration slider <-> custom input sync
    document.getElementById('durationSlider').addEventListener('input', (e) => {
        const ms = parseInt(e.target.value);
        document.getElementById('durationCustom').value = ms;
        document.getElementById('durationLabel').textContent = (ms / 1000) + 's';
    });

    document.getElementById('durationCustom').addEventListener('input', (e) => {
        const ms = parseInt(e.target.value) || 0;
        const slider = document.getElementById('durationSlider');
        slider.value = Math.min(ms, 60000);
        document.getElementById('durationLabel').textContent = (ms / 1000) + 's';
    });

    // Type radio -> show/hide control section (for new configs)
    document.querySelectorAll('input[name="gpioType"]').forEach(r => {
        r.addEventListener('change', (e) => {
            document.getElementById('controlSection').style.display = e.target.value === 'control' ? 'block' : 'none';
        });
    });

    loadGpioData().then(() => setupSSE());

    function setupUartSSE() {
        if (!uartConfigured) return;
        uartEventSource = new EventSource('/api/uart/stream');
        uartEventSource.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                if (data.type !== 'uart') return;
                if (currentUart && data.history) {
                    const list = document.getElementById('historyList');
                    const placeholder = list.querySelector(':scope > small');
                    if (placeholder) placeholder.remove();
                    const div = document.createElement('div');
                    div.className = 'border-bottom py-1 d-flex justify-content-between';
                    div.innerHTML = `<small>${data.history.payload}</small>
                        <small class="text-muted text-nowrap ms-2">${data.history.date}</small>`;
                    list.prepend(div);
                }
            } catch (error) {
                console.error('Error parsing UART SSE:', error);
            }
        };
        uartEventSource.onerror = () => {
            uartEventSource.close();
            setTimeout(setupUartSSE, 5000);
        };
    }

    setupUartSSE();

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closePanel();
    });

    window.addEventListener('beforeunload', () => {
        if (eventSource) eventSource.close();
        if (uartEventSource) uartEventSource.close();
    });
</script>
