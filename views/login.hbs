<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <h1 class="card-title text-center fw-light fs-4 mb-4">gpio2mqtt</h1>

            {{#if error}}
            <div class="alert alert-danger text-center py-2">{{error}}</div>
            {{/if}}

            <form method="POST" action="/login" id="loginForm">
                <div class="mb-3">
                    <input type="password" name="password" id="password" class="form-control" placeholder="{{t.app.password}}" autofocus>
                </div>
                <button type="submit" class="btn btn-primary w-100">{{t.app.login}}</button>
            </form>
        </div>
    </div>
</div>

